---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../../layouts/DocsLayout.astro";

export async function getStaticPaths() {
  const allDocs = await getCollection("docs");

  return allDocs.map((doc) => {
    const cleanId = doc.id.replace(/\.(md|mdx)$/, "");
    const parts = cleanId.split("/");
    const appId = parts[0] || doc.data.appId;
    const slug = parts.slice(1).join("/") || undefined;

    return {
      params: { appId, slug },
      props: { doc, allDocs },
    };
  });
}

const { doc, allDocs } = Astro.props;
const { Content, headings } = await render(doc);

const navItems = allDocs
  .sort((a, b) => a.data.order - b.data.order)
  .map((d) => {
    const cleanId = d.id.replace(/\.(md|mdx)$/, "");
    const parts = cleanId.split("/");
    const appId = parts[0] || d.data.appId;
    const slug = parts.slice(1).join("/");
    return {
      id: cleanId,
      title: d.data.title,
      appId,
      category: d.data.category,
      method: d.data.method,
      endpoint: d.data.endpoint,
      href: slug ? `/docs/${appId}/${slug}` : `/docs/${appId}`,
    };
  });
---

<DocsLayout
  title={doc.data.title}
  description={doc.data.description}
  appId={doc.data.appId}
  category={doc.data.category}
  method={doc.data.method}
  endpoint={doc.data.endpoint}
  headings={headings}
  allDocs={navItems}
  currentSlug={doc.id}
>
  <Content />
</DocsLayout>
