---
import "../styles/global.css";
import { AppSwitcher, ALL_APPS } from "../components/islands/AppSwitcher";
import { MethodBadge } from "../components/islands/MethodBadge";
import { ThemeToggle } from "../components/islands/ThemeToggle";

interface TocItem {
  depth: number;
  slug: string;
  text: string;
}

interface NavItem {
  id: string;
  title: string;
  appId: string;
  category: string;
  method?: string;
  endpoint?: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  appId: string;
  category?: string;
  method?: string;
  endpoint?: string;
  headings?: TocItem[];
  allDocs?: NavItem[];
  currentSlug?: string;
}

const {
  title,
  description,
  appId,
  category = "Tài liệu",
  method,
  endpoint,
  headings = [],
  allDocs = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://docs.vntez.net").href;
const currentApp = ALL_APPS.find((a) => a.id === appId) || ALL_APPS[0];

// Exact URL matching for 100% accurate active tab
const normalizedCurrentPath = (Astro.url.pathname || "/").replace(/\/$/, "") || "/";

const appDocs = allDocs.filter((d) => d.appId === appId);
const groupedCategories = appDocs.reduce<Record<string, NavItem[]>>((acc, item) => {
  if (!acc[item.category]) acc[item.category] = [];
  acc[item.category].push(item);
  return acc;
}, {});

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": title,
  "description": description,
  "url": canonicalURL,
  "publisher": {
    "@type": "Organization",
    "name": "VNTEZ Ecosystem",
    "url": "https://vntez.net",
  },
};
---

<!doctype html>
<html lang="vi" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — {currentApp.name} Docs</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} — ${currentApp.name} Docs`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="VNTEZ Documentation" />

    <!-- Anti-FOUC Theme Script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen bg-slate-50/50 dark:bg-[#0B0F19] text-slate-900 dark:text-slate-100 antialiased selection:bg-red-500/20 selection:text-red-500">
    <!-- Top Navigation Header -->
    <header class="sticky top-0 z-40 w-full border-b border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-[#0B0F19]/95 backdrop-blur-md">
      <div class="mx-auto flex h-14 max-w-[90rem] items-center justify-between px-4 sm:px-6">
        <div class="flex items-center gap-4">
          <a href="/" class="flex items-center gap-2.5 font-bold tracking-tight text-slate-900 dark:text-white hover:opacity-90">
            <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-red-600 text-white font-extrabold text-xs shadow-xs">V</span>
            <span class="text-sm font-bold tracking-tight">VNTEZ <span class="text-slate-500 dark:text-slate-400 font-medium">Docs</span></span>
          </a>

          <!-- Searchable App Switcher Dropdown (Scales to 50+ Apps cleanly) -->
          <AppSwitcher client:load currentAppId={appId} />
        </div>

        <div class="flex items-center gap-4 text-xs font-medium">
          <a href="https://vntez.net" class="text-slate-600 hover:text-slate-950 dark:text-slate-400 dark:hover:text-white transition-colors hidden sm:block">Portal</a>
          <a href="https://legal.vntez.net" class="text-slate-600 hover:text-slate-950 dark:text-slate-400 dark:hover:text-white transition-colors hidden sm:block">Legal SLA</a>
          <a href="https://github.com/hnamhocit" target="_blank" rel="noreferrer" class="text-slate-600 hover:text-slate-950 dark:text-slate-400 dark:hover:text-white transition-colors hidden sm:block">GitHub ↗</a>
          
          <!-- Light / Dark Theme Toggle Button -->
          <ThemeToggle client:load />
        </div>
      </div>
    </header>

    <!-- Main Container: 3 Columns with crisp vertical borders -->
    <div class="mx-auto max-w-[90rem] min-h-[calc(100vh-3.5rem)] border-x border-slate-200 dark:border-slate-800/80 bg-white dark:bg-[#0B0F19]">
      <div class="flex">
        <!-- 1. Left Sidebar: Category Tree Navigation with Vertical Border -->
        <aside class="sticky top-14 hidden h-[calc(100vh-3.5rem)] w-64 xl:w-72 shrink-0 overflow-y-auto border-r border-slate-200 dark:border-slate-800 p-5 lg:block bg-white dark:bg-[#0B0F19]">
          <!-- App Identity Card in Sidebar -->
          <div class="mb-5 pb-3 border-b border-slate-200 dark:border-slate-800">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-base">{currentApp.icon}</span>
              <h3 class="text-sm font-bold text-slate-900 dark:text-white truncate">{currentApp.name}</h3>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed">
              {currentApp.description}
            </p>
          </div>

          <!-- Quick Navigation Filter Search Input -->
          <div class="mb-4">
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-2.5 pointer-events-none text-slate-400 text-xs">
                🔍
              </span>
              <input
                type="text"
                id="doc-sidebar-filter"
                placeholder="Tìm trang hoặc API..."
                class="w-full pl-8 pr-2.5 py-1.5 text-xs rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-red-500 focus:border-red-500 transition-all font-sans"
                oninput="const q = this.value.toLowerCase(); document.querySelectorAll('.nav-tree-item').forEach(el => { const t = el.textContent.toLowerCase(); el.style.display = t.includes(q) ? 'flex' : 'none'; });"
              />
            </div>
          </div>

          <!-- Navigation Tree -->
          <nav class="space-y-5 text-xs">
            {Object.entries(groupedCategories).map(([catName, items]) => (
              <div>
                <h4 class="font-mono text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
                  {catName}
                </h4>
                <ul class="space-y-1">
                  {items.map((item) => {
                    const normalizedItemPath = (item.href || "/").replace(/\/$/, "") || "/";
                    const isCurrent = normalizedCurrentPath === normalizedItemPath;
                    return (
                      <li>
                        <a
                          href={item.href}
                          class:list={[
                            "nav-tree-item flex items-center justify-between rounded-lg px-2.5 py-1.5 transition-all text-xs font-medium",
                            isCurrent
                              ? "bg-red-500/10 font-semibold text-red-600 dark:text-red-400 border border-red-500/25 shadow-2xs"
                              : "text-slate-600 hover:text-slate-950 hover:bg-slate-100 dark:text-slate-400 dark:hover:text-slate-200 dark:hover:bg-slate-800/60",
                          ]}
                        >
                          <span class="truncate">{item.title}</span>
                          {item.method && (
                            <span class:list={[
                              "text-[9px] font-mono uppercase px-1.5 py-0.5 rounded font-bold shrink-0 ml-1.5",
                              item.method === "GET" && "bg-blue-100 text-blue-700 dark:bg-blue-950 dark:text-blue-400 border border-blue-200 dark:border-blue-900",
                              item.method === "POST" && "bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900",
                              item.method === "DELETE" && "bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-400 border border-red-200 dark:border-red-900",
                            ]}>
                              {item.method}
                            </span>
                          )}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </nav>
        </aside>

        <!-- 2. Middle Reading Column: Clean Spacing & Typography -->
        <main class="min-w-0 flex-1 px-6 sm:px-10 lg:px-12 py-8 max-w-4xl">
          <!-- Breadcrumb Path -->
          <div class="mb-4 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 font-mono">
            <a href="/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Docs</a>
            <span>/</span>
            <span class="font-medium text-slate-700 dark:text-slate-300">{currentApp.name}</span>
            <span>/</span>
            <span>{category}</span>
          </div>

          <!-- Document Header -->
          <div class="mb-6 space-y-3 pb-6 border-b border-slate-200 dark:border-slate-800">
            <div class="flex items-center gap-3">
              {method && <MethodBadge method={method} />}
              {endpoint && (
                <code class="text-xs font-mono font-semibold text-slate-800 dark:text-slate-200 bg-slate-100 dark:bg-slate-900 px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-800">
                  {endpoint}
                </code>
              )}
            </div>
            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-950 dark:text-white">
              {title}
            </h1>
            <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
              {description}
            </p>
          </div>

          <!-- Article Content with Prose Typography -->
          <article class="prose prose-slate dark:prose-invert max-w-none text-slate-700 dark:text-slate-300 prose-headings:text-slate-950 dark:prose-headings:text-white prose-headings:font-bold prose-h2:text-xl prose-h2:border-b prose-h2:border-slate-200 dark:prose-h2:border-slate-800 prose-h2:pb-2 prose-h2:mt-8 prose-h3:text-base prose-a:text-red-600 dark:prose-a:text-red-400 prose-a:font-semibold prose-code:text-red-600 dark:prose-code:text-red-400 prose-code:bg-slate-100 dark:prose-code:bg-slate-900 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-xs prose-code:before:content-none prose-code:after:content-none leading-relaxed">
            <slot />
          </article>
        </main>

        <!-- 3. Right Column: Sticky Table of Contents (TOC) with Vertical Border -->
        <aside class="sticky top-14 hidden h-[calc(100vh-3.5rem)] w-60 xl:w-68 shrink-0 overflow-y-auto border-l border-slate-200 dark:border-slate-800 p-5 xl:block bg-white dark:bg-[#0B0F19]">
          <div class="space-y-4">
            <div class="flex items-center gap-2">
              <span class="text-xs">📑</span>
              <h4 class="font-mono text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                Mục lục trang
              </h4>
            </div>

            {headings.length === 0 ? (
              <p class="text-xs text-slate-400">Tổng quan tài liệu</p>
            ) : (
              <ul class="space-y-1.5 text-xs">
                {headings.map((h) => (
                  <li style={{ paddingLeft: `${Math.max(0, h.depth - 2) * 10}px` }}>
                    <a
                      href={`#${h.slug}`}
                      class="block py-1 text-slate-600 hover:text-slate-950 dark:text-slate-400 dark:hover:text-white transition-colors truncate font-medium hover:translate-x-0.5 transition-transform"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            )}

            <!-- Feedback Box (SlothUI / React Docs style) -->
            <div class="mt-8 pt-6 border-t border-slate-200 dark:border-slate-800 space-y-2.5">
              <span class="text-xs font-semibold text-slate-700 dark:text-slate-300 block">
                Trang này có hữu ích không?
              </span>
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  id="btn-feedback-yes"
                  class="flex-1 py-1.5 px-2.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-medium text-slate-700 dark:text-slate-300 transition-colors cursor-pointer text-center"
                >
                  👍 Có
                </button>
                <button
                  type="button"
                  id="btn-feedback-no"
                  class="flex-1 py-1.5 px-2.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-medium text-slate-700 dark:text-slate-300 transition-colors cursor-pointer text-center"
                >
                  👎 Không
                </button>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <script is:inline>
      document.getElementById('btn-feedback-yes')?.addEventListener('click', function() {
        this.textContent = 'Cảm ơn bạn! ✓';
        this.classList.add('bg-emerald-500/10', 'text-emerald-500', 'border-emerald-500/30');
      });
      document.getElementById('btn-feedback-no')?.addEventListener('click', function() {
        this.textContent = 'Đã ghi nhận';
        this.classList.add('bg-slate-200', 'dark:bg-slate-700');
      });
    </script>
  </body>
</html>
