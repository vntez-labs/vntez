---
import "../styles/global.css";

interface TocItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  version?: string;
  effectiveDate?: string;
  lastUpdated?: string;
  headings?: TocItem[];
  currentSlug?: string;
}

const {
  title,
  description,
  version = "2.5.0",
  effectiveDate = "2026-01-01",
  lastUpdated = "2026-11-07",
  headings = [],
  currentSlug = "",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://legal.vntez.net").href;

const LEGAL_DOCS = [
  { slug: "terms-of-service", title: "Điều Khoản Dịch Vụ", badge: "v2.5.0", icon: "⚖️" },
  { slug: "privacy-policy", title: "Chính Sách Bảo Mật", badge: "v2.5.0", icon: "🛡️" },
  { slug: "data-sovereignty-sla", title: "Cam Kết Chủ Quyền & SLA", badge: "v2.1.0", icon: "🇻🇳" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": canonicalURL,
  "version": version,
  "datePublished": effectiveDate,
  "dateModified": lastUpdated,
  "publisher": {
    "@type": "Organization",
    "name": "VNTEZ Ecosystem",
    "url": "https://vntez.net",
  },
};
---

<!doctype html>
<html lang="vi" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — VNTEZ Legal & SLA</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} — VNTEZ Legal`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="VNTEZ Legal Compliance" />

    <!-- Anti-FOUC Theme Initialization (0kb runtime) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen bg-slate-50/50 dark:bg-[#0B0F19] text-slate-800 dark:text-slate-200 antialiased selection:bg-red-500/20 selection:text-red-500">
    <!-- Header -->
    <header class="border-b border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-[#0B0F19]/95 backdrop-blur-md sticky top-0 z-40">
      <div class="mx-auto flex h-14 max-w-[90rem] items-center justify-between px-4 sm:px-6">
        <a href="/" class="flex items-center gap-2.5 font-bold tracking-tight text-slate-900 dark:text-white hover:opacity-90">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-red-600 text-white font-extrabold text-xs shadow-xs">V</span>
          <span class="text-sm font-bold tracking-tight">VNTEZ <span class="text-slate-500 dark:text-slate-400 font-medium">Legal & SLA</span></span>
        </a>

        <div class="flex items-center gap-4 text-xs font-medium">
          <a href="/" class="text-slate-600 hover:text-slate-950 dark:text-slate-400 dark:hover:text-white transition-colors hidden sm:block">Trung tâm Pháp lý</a>
          <a href="https://docs.vntez.net" class="text-slate-600 hover:text-slate-950 dark:text-slate-400 dark:hover:text-white transition-colors hidden sm:block">Tài liệu Docs</a>
          <a href="https://vntez.net" class="text-slate-600 hover:text-slate-950 dark:text-slate-400 dark:hover:text-white transition-colors hidden sm:block">Portal ↗</a>
          
          <!-- Pure JS/HTML Theme Toggle (0kb React bundle) -->
          <button
            type="button"
            onclick="const isDark = document.documentElement.classList.toggle('dark'); localStorage.setItem('theme', isDark ? 'dark' : 'light');"
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white transition-colors cursor-pointer"
            title="Đổi giao diện Sáng / Tối"
            aria-label="Toggle theme"
          >
            <span class="dark:hidden">🌙</span>
            <span class="hidden dark:inline">☀️</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content Container with crisp column borders -->
    {currentSlug ? (
      <div class="mx-auto max-w-[90rem] min-h-[calc(100vh-3.5rem)] border-x border-slate-200 dark:border-slate-800/80 bg-white dark:bg-[#0B0F19]">
        <div class="flex">
          <!-- Left Column: Document Switcher Sidebar with Right Border (Compact width) -->
          <aside class="sticky top-14 hidden h-[calc(100vh-3.5rem)] w-52 xl:w-60 shrink-0 overflow-y-auto border-r border-slate-200 dark:border-slate-800 p-3.5 sm:p-4 lg:block bg-white dark:bg-[#0B0F19]">
            <span class="text-[10px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 font-bold block mb-3">
              Danh mục văn bản
            </span>
            <nav class="space-y-1 text-xs">
              {LEGAL_DOCS.map((doc) => {
                const isActive = currentSlug.includes(doc.slug);
                return (
                  <a
                    href={`/${doc.slug}`}
                    class:list={[
                      "flex items-center justify-between p-2.5 rounded-lg transition-all font-medium",
                      isActive
                        ? "bg-red-500/10 text-red-600 dark:text-red-400 font-semibold border border-red-500/25 shadow-2xs"
                        : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60",
                    ]}
                  >
                    <div class="flex items-center gap-2 truncate">
                      <span>{doc.icon}</span>
                      <span class="truncate">{doc.title}</span>
                    </div>
                    <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 shrink-0">
                      {doc.badge}
                    </span>
                  </a>
                );
              })}
            </nav>

            <div class="mt-6 pt-4 border-t border-slate-200 dark:border-slate-800 space-y-2">
              <button
                type="button"
                onclick="window.print()"
                class="w-full flex items-center justify-center gap-2 py-2 px-3 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-300 transition-colors cursor-pointer"
              >
                <span>🖨️</span>
                <span>In / Lưu PDF văn bản</span>
              </button>
            </div>

            <div class="mt-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 p-4 text-xs space-y-1.5">
              <span class="font-bold text-slate-900 dark:text-white block">Tuân thủ Pháp lý</span>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">
                Được bảo đảm bởi Ban Quản trị Pháp chế VNTEZ. Tuân thủ Nghị định 13/2023/NĐ-CP và tiêu chuẩn ISO/IEC 27001.
              </p>
            </div>
          </aside>

          <!-- Center Reading Column -->
          <main class="min-w-0 flex-1 px-6 sm:px-10 lg:px-12 py-8 max-w-4xl">
            <slot />
          </main>

          <!-- Right Column: Table of Contents with Left Border -->
          {headings.length > 0 && (
            <aside class="sticky top-14 hidden h-[calc(100vh-3.5rem)] w-60 xl:w-68 shrink-0 overflow-y-auto border-l border-slate-200 dark:border-slate-800 p-5 xl:block text-xs bg-white dark:bg-[#0B0F19]">
              <span class="font-mono text-[10px] uppercase tracking-wider text-slate-500 dark:text-slate-400 font-bold block mb-3">
                Mục lục văn bản
              </span>
              <ul class="space-y-2">
                {headings.map((h) => (
                  <li style={{ paddingLeft: `${Math.max(0, h.depth - 2) * 10}px` }}>
                    <a
                      href={`#${h.slug}`}
                      class="block text-slate-600 hover:text-slate-950 dark:text-slate-400 dark:hover:text-white transition-colors truncate font-medium hover:translate-x-0.5 transition-transform"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </aside>
          )}
        </div>
      </div>
    ) : (
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-10">
        <slot />
      </div>
    )}

    <!-- Footer -->
    <footer class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0B0F19] py-8 text-center text-xs text-slate-500 dark:text-slate-400 space-y-2">
      <div class="mx-auto max-w-[90rem] px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>© 2026 VNTEZ Ecosystem. Mọi quyền được bảo lưu.</p>
        <p>Bảo vệ dữ liệu cá nhân theo Nghị định 13/2023/NĐ-CP • Hạ tầng Cloudflare Tier-3 nội địa.</p>
        <p>Liên hệ DPO: <a href="mailto:legal@vntez.net" class="text-red-500 font-semibold hover:underline">legal@vntez.net</a></p>
      </div>
    </footer>
  </body>
</html>
