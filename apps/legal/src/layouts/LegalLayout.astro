---
import "../styles/global.css";

interface TocItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  version: string;
  effectiveDate: string;
  lastUpdated: string;
  headings?: TocItem[];
}

const {
  title,
  description,
  version,
  effectiveDate,
  lastUpdated,
  headings = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://legal.vntez.net").href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": canonicalURL,
  "datePublished": effectiveDate,
  "dateModified": lastUpdated,
  "publisher": {
    "@type": "Organization",
    "name": "VNTEZ Ecosystem",
    "url": "https://vntez.net",
  },
};
---

<!doctype html>
<html lang="vi" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — VNTEZ Legal Portal</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} — VNTEZ Legal`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="VNTEZ Legal Compliance" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen bg-[#0B0F19] text-slate-200 antialiased selection:bg-red-500/20 selection:text-red-400">
    <!-- Header -->
    <header class="border-b border-slate-800/80 bg-[#0B0F19]/90 backdrop-blur-md sticky top-0 z-40">
      <div class="mx-auto flex h-14 max-w-4xl items-center justify-between px-4 sm:px-6">
        <a href="/" class="flex items-center gap-2.5 font-bold tracking-tight text-white hover:opacity-90">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-red-600 text-white font-extrabold text-xs">V</span>
          <span class="text-sm font-semibold">VNTEZ <span class="text-slate-400 font-normal">Legal</span></span>
        </a>

        <nav class="flex items-center gap-4 text-xs font-medium">
          <a href="/terms-of-service" class="text-slate-400 hover:text-white transition-colors">Điều khoản</a>
          <a href="/privacy-policy" class="text-slate-400 hover:text-white transition-colors">Bảo mật</a>
          <a href="/data-sovereignty-sla" class="text-slate-400 hover:text-white transition-colors">Data Sovereignty SLA</a>
          <a href="https://vntez.net" class="text-slate-400 hover:text-white transition-colors">Portal ↗</a>
        </nav>
      </div>
    </header>

    <!-- 1-Column Reading-Focused Container -->
    <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
      <!-- Title & Version Metadata Badges -->
      <header class="mb-8 border-b border-slate-800 pb-8">
        <div class="flex flex-wrap items-center gap-2 mb-3 font-mono text-xs">
          <span class="px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700/80">
            Phiên bản {version}
          </span>
          <span class="px-2.5 py-0.5 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20">
            Hiệu lực: {effectiveDate}
          </span>
          <span class="text-slate-400">
            Cập nhật gần nhất: {lastUpdated}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white mb-3">
          {title}
        </h1>
        <p class="text-base text-slate-400 leading-relaxed">
          {description}
        </p>

        <!-- Sticky Mini TOC Anchor Links (Pure HTML) -->
        {headings.length > 0 && (
          <nav aria-label="Mục lục văn bản" class="mt-6 p-4 rounded-xl bg-[#111827] border border-slate-800 text-xs">
            <span class="font-mono uppercase tracking-wider text-slate-400 font-semibold block mb-2">
              Mục lục văn bản
            </span>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
              {headings.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="text-slate-300 hover:text-red-400 transition-colors truncate block">
                    → {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </header>

      <!-- Legal Document Prose Content (0kb JS) -->
      <article class="prose prose-invert prose-slate max-w-none text-slate-300 prose-headings:text-white prose-headings:font-bold prose-h2:border-b prose-h2:border-slate-800/80 prose-h2:pb-2 prose-a:text-red-400 prose-strong:text-white prose-li:marker:text-red-500">
        <slot />
      </article>

      <!-- Footer Compliance Assurance -->
      <footer class="mt-16 border-t border-slate-800 pt-8 text-center text-xs text-slate-400 space-y-2">
        <p>© 2026 VNTEZ Ecosystem. Bảo lưu mọi quyền.</p>
        <p>Tuân thủ Nghị định 13/2023/NĐ-CP về Bảo vệ dữ liệu cá nhân tại Việt Nam và quy chuẩn GDPR.</p>
      </footer>
    </main>
  </body>
</html>
